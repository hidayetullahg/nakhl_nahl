# ==============================================================================
# NAKHL & NAHL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit actual secrets, private keys, or passwords to Git.
# Copy this file to .env.development, .env.staging, or .env.production as needed.
# ==============================================================================

# 1. Environment Flag (dev | staging | prod)
APP_ENV=dev

# 2. Supabase Backend
# Public / Anon Key is safe for client applications with Row Level Security (RLS)
SUPABASE_URL=https://nakhl-nahl.supabase.co
SUPABASE_ANON_KEY=public-anon-key-placeholder

# 3. ZATCA E-Invoicing Phase 2 Integration
# Valid options: DEVELOPER_SANDBOX | SIMULATION | CORE_PRODUCTION
ZATCA_ENV=DEVELOPER_SANDBOX

# 4. Monitoring & Telemetry (Optional / Production only)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# 5. Build Flags
ENABLE_LOGGING=true
ENABLE_MOCK_AUTH=false
